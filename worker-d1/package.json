{
  "name": "reset-tracker-worker-d1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check": "npm run types && npm run typecheck && npm run deploy:dry",
    "db:local": "wrangler d1 migrations apply reset-tracker-db --local",
    "db:remote": "wrangler d1 migrations apply reset-tracker-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260809.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  }
}
